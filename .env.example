# ------------------------------------------------------------------
# CloudBase (replaces Supabase)
# ------------------------------------------------------------------
# CloudBase environment id. Example: YOUR_CLOUDBASE_ENV_ID
TCB_ENV=
# CloudBase server API Key (preferred).
# Create one in the console: 环境 -> 鉴权 -> API Key 管理.
# The Node SDK reads this automatically when CLOUDBASE_APIKEY is set.
CLOUDBASE_APIKEY=
# Alternative credential path: Tencent Cloud permanent key pair.
# Use a CAM sub-account with minimal permissions, NOT the root account.
# Uncomment if you cannot use a server API Key.
# TENCENTCLOUD_SECRETID=
# TENCENTCLOUD_SECRETKEY=

# Public env id exposed to the browser if any client code needs it.
NEXT_PUBLIC_TCB_ENV=

# ------------------------------------------------------------------
# Next.js app
# ------------------------------------------------------------------
# Base URL used to build access URLs returned to the client.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret protecting the HTTP entry of /api/files/cleanup and /api/files/delete.
# The CloudBase scheduled cloud function (cloudfunctions/cleanupExpiredFiles) does
# NOT need this — it runs the same logic directly. Keep this only for manual /
# external cron triggers hitting the Next.js route.
CRON_SECRET=

# ------------------------------------------------------------------
# S3 / S3-compatible storage (unchanged from the previous setup)
# ------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
# Optional custom endpoint for S3-compatible storage (e.g. MinIO, COS).
AWS_ENDPOINT=
# Set to "true" when using path-style addressing (MinIO, etc.).
AWS_FORCE_PATH_STYLE=

# ------------------------------------------------------------------
# Optional CDN signed-URL feature (Type-A 鉴权)
# ------------------------------------------------------------------
# CDN_DOMAIN=
# TYPEA_SIGN_TOKEN=
# Query-param name carrying the auth token. Defaults to "sign".
# Set only if your CDN / origin expects a different name (e.g. "key", "auth_key").
# TYPEA_SIGN_PARAM=sign

# ------------------------------------------------------------------
# Variables REMOVED after migration:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
# ------------------------------------------------------------------
